# Twilio (gercek telefon modu icin gerekli, demo modunda gerekmez)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ElevenLabs TTS (yoksa sistem mock ses uretir, sistem yine de calisir)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Ollama / Gemma (yoksa mock analiz verisi kullanilir)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Whisper model boyutu: base (hizli) | small | medium
WHISPER_MODEL=base

# Demo modunu zorla aktif et (Twilio olmadan calistirmak icin)
# 1 yapilirsa /voice webhook devre disi, /api/simulate-call calisir
TWILIO_FALLBACK=true
